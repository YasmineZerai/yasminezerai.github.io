---
import Defs from './Defs.astro';
interface Props {
  l: Record<string, any>;
  uid: string;
}
const { l, uid } = Astro.props;
const a = `url(#${uid}-a)`;
const aa = `url(#${uid}-aa)`;
---

<Defs uid={uid} />

<!-- The loop -->
<rect class="group" x="10" y="10" width="650" height="300" rx="10"></rect>
<text class="m" x="26" y="32">{l.limit}</text>

<rect class="box" x="30" y="110" width="210" height="60" rx="8"></rect>
<text class="t-sm" x="135" y="134" text-anchor="middle">{l.context}</text>
<text class="m" x="135" y="155" text-anchor="middle">{l.context_note}</text>
<path class="edge" d="M240 140 H288" marker-end={a}></path>

<rect class="box-accent" x="290" y="110" width="170" height="60" rx="8"></rect>
<text class="t-accent" x="375" y="134" text-anchor="middle">{l.llm}</text>
<text class="m" x="375" y="155" text-anchor="middle">{l.llm_note}</text>
<path class="edge" d="M460 140 H488" marker-end={a}></path>

<path class="box" d="M540 96 L594 140 L540 184 L486 140 Z"></path>
<text class="m" x="540" y="144" text-anchor="middle" style="fill: var(--d-text)">{l.decide}</text>

<!-- yes: run tools, back to context -->
<path class="edge" d="M540 184 V255 H522" marker-end={a}></path>
<text class="m" x="550" y="214">{l.yes}</text>
<rect class="box" x="300" y="225" width="220" height="60" rx="8"></rect>
<text class="t-sm" x="410" y="249" text-anchor="middle">{l.execute}</text>
<text class="m" x="410" y="270" text-anchor="middle">{l.execute_note}</text>
<path class="edge edge-dash" d="M300 255 H135 V172" marker-end={a}></path>

<!-- no: result -->
<path class="edge-accent" d="M594 140 H698" marker-end={aa}></path>
<text class="m" x="612" y="130">{l.no}</text>
<rect class="box-accent" x="700" y="110" width="170" height="60" rx="8"></rect>
<text class="t-accent" x="785" y="145" text-anchor="middle">{l.result}</text>

<!-- Read/action rule -->
<rect class="box" x="30" y="330" width="300" height="70" rx="8"></rect>
<text class="t-sm" x="46" y="358">{l.read}</text>
<text class="m" x="46" y="382">{l.read_examples}</text>

<text class="t-accent" x="435" y="352" text-anchor="middle">{l.rule}</text>
<path class="edge-bad" d="M345 368 H525"></path>
<text class="m-bad" x="435" y="390" text-anchor="middle">{l.rule_note}</text>

<rect class="box" x="540" y="330" width="330" height="70" rx="8"></rect>
<text class="t-sm" x="556" y="358">{l.action}</text>
<text class="m" x="556" y="382">{l.action_examples}</text>

<!-- What each agent declares -->
<text class="m" x="30" y="446">{l.declares}:</text>
{
  l.declares_items.map((it: string, i: number) => (
    <>
      <rect class="box-2" x={250 + i * 160} y="426" width="150" height="30" rx="6" />
      <text class="m" x={325 + i * 160} y="446" text-anchor="middle" style="fill: var(--d-text)">
        {it}
      </text>
    </>
  ))
}
