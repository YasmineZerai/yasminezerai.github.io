---
import Defs from './Defs.astro';
interface Props {
  l: Record<string, any>;
  uid: string;
}
const { l, uid } = Astro.props;
const a = `url(#${uid}-a)`;
const aa = `url(#${uid}-aa)`;
const ab = `url(#${uid}-ab)`;
const tools: string[] = l.tools;
const last = tools.length - 1;
---

<Defs uid={uid} />

<!-- Trigger -->
<rect class="box-2" x="10" y="170" width="140" height="48" rx="8"></rect>
<text class="t-sm" x="80" y="199" text-anchor="middle">{l.anomaly}</text>
<path class="edge" d="M150 194 H218" marker-end={a}></path>

<!-- Agent -->
<rect class="box-accent" x="220" y="150" width="170" height="88" rx="8"></rect>
<text class="t-accent" x="305" y="199" text-anchor="middle">{l.agent}</text>

<!-- Agent and tools talk both ways -->
<path class="edge-accent" d="M390 178 H438" marker-end={aa}></path>
<path class="edge edge-dash" d="M440 210 H392" marker-end={a}></path>

<!-- Tools -->
<rect class="box" x="440" y="20" width="200" height="236" rx="8"></rect>
<text class="t" x="456" y="46">{l.tools_title}</text>
{
  tools.map((t, i) => (
    <text class={i === last ? 'm-accent' : 'm'} x="456" y={74 + i * 26}>
      {i === last ? '→ ' : '· '}
      {t}
    </text>
  ))
}

<!-- Neighbour check -->
<path class="edge-accent" d={`M640 ${74 + last * 26 - 4} C 665 ${74 + last * 26 - 4}, 665 172, 688 172`} marker-end={aa}></path>
<rect class="box-accent" x="690" y="150" width="180" height="44" rx="8"></rect>
<text class="t-accent" x="780" y="177" text-anchor="middle">{l.neighbour}</text>

<path class="edge" d="M790 194 V228" marker-end={a}></path>
<rect class="box" x="710" y="230" width="160" height="56" rx="8"></rect>
<text class="m" x="790" y="252" text-anchor="middle">{l.same}</text>
<text class="t-sm" x="790" y="274" text-anchor="middle">→ {l.same_out}</text>

<path class="edge" d="M698 194 V328 H708" marker-end={a}></path>
<rect class="box" x="710" y="300" width="160" height="56" rx="8"></rect>
<text class="m" x="790" y="322" text-anchor="middle">{l.only}</text>
<text class="t-sm" x="790" y="344" text-anchor="middle">→ {l.only_out}</text>

<!-- Schema validation and self-correction -->
<path class="edge" d="M305 238 V298" marker-end={a}></path>
<rect class="box" x="220" y="300" width="170" height="48" rx="8"></rect>
<text class="t-sm" x="305" y="329" text-anchor="middle">{l.schema}</text>
<path class="edge-bad" d="M220 324 H190 V214 H218" marker-end={ab}></path>
<text class="m-bad" x="182" y="290" text-anchor="end">{l.retry[0]}</text>
<text class="m-bad" x="182" y="306" text-anchor="end">{l.retry[1]}</text>

<!-- Out -->
<path class="edge-accent" d="M390 324 H438" marker-end={aa}></path>
<rect class="box-accent" x="440" y="300" width="200" height="48" rx="8"></rect>
<text class="t-sm" x="540" y="329" text-anchor="middle">{l.out}</text>
<text class="m" x="540" y="374" text-anchor="middle">{l.trace}</text>
