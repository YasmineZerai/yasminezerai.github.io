---
// A project or company logo. SVGs are served as-is; raster logos go through the image pipeline.
import { Image } from 'astro:assets';
import { image } from '../lib/images';

interface Props {
  src: string;
  class?: string;
  px: number;
}
const { src, class: cls, px } = Astro.props;
const img = image(src);
const isSvg = src.endsWith('.svg');
---

{
  isSvg ? (
    <img src={img.src} alt="" width={px} height={Math.round((px * img.height) / img.width)} class={cls} />
  ) : (
    <Image src={img} alt="" widths={[px, px * 2]} sizes={`${px}px`} class={cls} />
  )
}
