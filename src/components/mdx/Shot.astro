---
// A screenshot slot. Until the image exists in src/assets, it shows a visible placeholder.
import { Image } from 'astro:assets';
import { tryImage } from '../../lib/images';
interface Props {
  src: string;
  alt: string;
  caption: string;
}
const { src, alt, caption } = Astro.props;
const img = tryImage(src);
---

<figure class="reveal my-8">
  {
    img ? (
      <div class="overflow-hidden rounded-2xl border border-line bg-surface shadow-[var(--shadow)]">
        <Image src={img} alt={alt} widths={[480, 800, 1200, Math.min(img.width, 1600)]} sizes="(min-width: 768px) 46rem, 100vw" loading="lazy" class="h-auto w-full" />
      </div>
    ) : (
      <div class="grid aspect-[16/9] place-items-center rounded-2xl border-2 border-dashed border-c bg-c-soft p-6 text-center">
        <p>
          <span class="todo">TODO(yasmine): add {src}</span>
          <span class="mt-2 block text-sm text-muted">{alt}</span>
        </p>
      </div>
    )
  }
  <figcaption class="mt-3 text-sm text-muted">{caption}</figcaption>
</figure>
