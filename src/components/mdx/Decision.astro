---
import { getUi } from '../../lib/content';
interface Props {
  title: string;
  source?: { label: string; href: string };
}
const { title, source } = Astro.props;
const ui = await getUi();
---

<section class="decision reveal tilt card relative my-6 overflow-hidden p-5 pl-6 sm:p-6 sm:pl-7">
  <span class="absolute inset-y-0 left-0 w-1.5 bg-c" aria-hidden="true"></span>
  <h3 class="flex items-start gap-3 text-lg leading-snug font-bold">
    <span class="mt-[0.2em] grid size-6 shrink-0 place-items-center rounded-full bg-c-soft text-c-strong" aria-hidden="true"><svg class="size-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 8.5 3 3 7-7"/></svg></span>
    <span>{title}</span>
  </h3>
  <div class="decision-body mt-2 pl-9 text-[1rem] leading-relaxed">
    <slot />
  </div>
  {
    source && (
      <p class="mt-3 pl-9">
        <a href={source.href} class="label link">
          {source.label} · {ui.decision_source}
        </a>
      </p>
    )
  }
</section>

<style>
  .decision-body :global(strong) { font-weight: 620; }
  .decision-body :global(p + p) { margin-top: 0.75rem; }
</style>
