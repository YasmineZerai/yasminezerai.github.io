---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<div class="step grid gap-1 px-5 py-4 sm:grid-cols-[10rem_1fr] sm:gap-6 sm:px-6">
  <p class="pt-0.5 font-mono text-xs font-semibold text-c-strong">{label}</p>
  <div class="text-[1rem] leading-relaxed"><slot /></div>
</div>

<style>
  .step :global(strong) { font-weight: 620; }
</style>
