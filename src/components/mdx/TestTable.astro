---
import { getUi } from '../../lib/content';
interface Props {
  rows: { scenario: string; agent: string; expected: string; passed: boolean }[];
}
const { rows } = Astro.props;
const ui = await getUi();
---

<div class="card my-6 overflow-x-auto" tabindex="0" role="region" aria-label="Agent test scenarios">
  <table class="w-full min-w-[34rem] text-left text-[0.9375rem]">
    <thead class="bg-c-soft">
      <tr>
        <th scope="col" class="px-4 py-3 font-mono text-xs font-semibold text-c-strong">{ui.test_scenario}</th>
        <th scope="col" class="px-4 py-3 font-mono text-xs font-semibold text-c-strong">{ui.test_agent}</th>
        <th scope="col" class="px-4 py-3 font-mono text-xs font-semibold text-c-strong">{ui.test_expected}</th>
        <th scope="col" class="px-4 py-3 font-mono text-xs font-semibold text-c-strong">{ui.test_result}</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line">
      {
        rows.map((r) => (
          <tr class="align-top">
            <td class="px-4 py-3">{r.scenario}</td>
            <td class="px-4 py-3 font-mono text-sm text-muted">{r.agent}</td>
            <td class="px-4 py-3">{r.expected}</td>
            <td class="px-4 py-3 whitespace-nowrap">
              {r.passed && (
                <span class="badge !bg-[var(--mint-soft)] !text-[var(--mint-strong)]">
                  {ui.test_passed}
                </span>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
