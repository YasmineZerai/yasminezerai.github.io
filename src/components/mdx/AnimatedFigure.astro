---
import { Image } from 'astro:assets';
import { image } from '../../lib/images';
import { getUi } from '../../lib/content';
interface Props {
  poster: string;
  src: string;
  alt: string;
  caption?: string;
}
const { poster, src, alt, caption } = Astro.props;
const img = image(poster);
const ui = await getUi();
---

<figure class="anim my-8" data-src={src}>
  <div class="relative overflow-hidden rounded-2xl border border-line bg-surface shadow-[var(--shadow)]">
    <Image
      src={img}
      alt={alt}
      widths={[480, 800, 1100]}
      sizes="(min-width: 768px) 46rem, 100vw"
      loading="eager"
      fetchpriority="high"
      class="anim-img h-auto w-full"
    />
    <button
      type="button"
      class="anim-play absolute right-3 bottom-3 hidden rounded-md border border-line-strong bg-surface px-3 py-2 font-mono text-xs hover:border-accent hover:text-accent"
    >
      {ui.play_demo}
    </button>
  </div>
  {caption && <figcaption class="mt-3 text-sm text-muted">{caption}</figcaption>}
</figure>

<script>
  // The poster loads first; the 2 MB animation swaps in once the page has loaded.
  // With reduced motion, it waits for a click instead.
  document.querySelectorAll<HTMLElement>('.anim').forEach((fig) => {
    const img = fig.querySelector<HTMLImageElement>('.anim-img');
    const btn = fig.querySelector<HTMLButtonElement>('.anim-play');
    const src = fig.dataset.src;
    if (!img || !src) return;
    const play = () => {
      const pre = new Image();
      pre.onload = () => {
        img.removeAttribute('srcset');
        img.removeAttribute('sizes');
        img.src = src;
        btn?.classList.add('hidden');
      };
      pre.src = src;
    };
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      btn?.classList.remove('hidden');
      btn?.addEventListener('click', play, { once: true });
    } else if (document.readyState === 'complete') {
      setTimeout(play, 300);
    } else {
      window.addEventListener('load', () => setTimeout(play, 300), { once: true });
    }
  });
</script>
