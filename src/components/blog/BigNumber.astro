---
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---

<div class="reveal glass c-peach relative isolate my-8 overflow-hidden rounded-3xl p-6 sm:flex sm:items-center sm:gap-8 sm:p-8">
  <p class="font-display text-6xl leading-none font-extrabold tracking-tighter text-c-strong sm:text-7xl">{value}</p>
  <div class="mt-3 sm:mt-0">
    <p class="font-display text-xl leading-snug font-bold">{label}</p>
    <p class="mt-1 text-muted"><slot /></p>
  </div>
</div>
