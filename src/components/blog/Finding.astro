---
import Icon from './Icon.astro';
interface Props {
  n: string;
  title: string;
  icon?: string;
  color?: 'peach' | 'mint' | 'sky' | 'lilac';
}
const { n, title, icon, color = 'mint' } = Astro.props;
---

<section class:list={['finding reveal relative my-4 overflow-hidden rounded-3xl border border-white/10 bg-white/[0.035] p-5 sm:p-6', `c-${color}`]}>
  <span class="absolute inset-y-5 left-0 w-[3px] rounded-r-full bg-c-strong" aria-hidden="true"></span>
  <div class="flex items-start gap-4">
    <span class="icon-tile relative grid size-11 shrink-0 place-items-center rounded-2xl text-c-strong" aria-hidden="true">
      {icon ? <Icon name={icon} class="size-[22px]" /> : <span class="font-mono text-sm font-bold">{n}</span>}
      {icon && <span class="absolute -top-1.5 -right-1.5 grid size-5 place-items-center rounded-full bg-c-strong font-mono text-[0.625rem] font-bold text-[#13111c]">{n}</span>}
    </span>
    <div class="min-w-0">
      <h3 class="font-display text-lg leading-snug font-bold">{title}</h3>
      <div class="finding-body mt-1.5 text-[1rem] leading-relaxed text-ink/90"><slot /></div>
    </div>
  </div>
</section>

<style>
  .finding { transition: border-color 200ms, background-color 200ms, transform 200ms; }
  .finding:hover { border-color: color-mix(in oklab, var(--c-strong) 45%, transparent); background: rgb(255 255 255 / 0.05); transform: translateY(-2px); }
  .icon-tile {
    background: color-mix(in oklab, var(--c-strong) 14%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--c-strong) 35%, transparent);
  }
  .finding-body :global(strong) { font-weight: 650; color: var(--text); }
  .finding-body :global(code) {
    font-family: var(--ff-mono); font-size: 0.85em; padding: 0.1em 0.4em; border-radius: 6px;
    background: color-mix(in oklab, var(--c-strong) 12%, transparent); color: var(--text);
  }
</style>
