---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Thumb from '../components/diagrams/Thumb.astro';
import Collage from '../components/Collage.astro';
import Logo from '../components/Logo.astro';
import { LOCALE, md } from '../lib/content';
import { image } from '../lib/images';
import profile from '../assets/profile-square.jpg';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/blog';
import { getUi } from '../lib/content';

const entry = await getEntry('home', LOCALE);
if (!entry) throw new Error('Missing home content');
const { meta, hero, work, looking, experience, education, skills, contact } = entry.data;
const ui = await getUi();
const latestPosts = (await getPosts()).slice(0, 2);
---

<Base title={meta.title} description={meta.description}>
  <!-- Hero -->
  <section class="relative isolate overflow-x-clip">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="blob absolute -top-24 left-[4%] size-[24rem] rounded-full bg-[var(--peach)] opacity-60 blur-3xl"></div>
      <div class="blob absolute top-24 right-[4%] size-[26rem] rounded-full bg-[var(--lilac)] opacity-60 blur-3xl"></div>
      <div class="blob absolute bottom-[-4rem] left-[30%] size-[22rem] rounded-full bg-[var(--mint)] opacity-50 blur-3xl"></div>
    </div>

    <div class="container-page grid items-center gap-10 pt-12 pb-20 md:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] md:gap-12 md:pt-20 md:pb-28 lg:gap-16">
      <!-- Photo -->
      <div class="relative mx-auto w-full max-w-[16rem] sm:max-w-[18rem] md:-mt-16 md:max-w-[21rem]">
        <div class="relative aspect-square">
          <div
            class="ring absolute -inset-2 rounded-full bg-[conic-gradient(from_0deg,#ffc4a6,#cdb9ff,#a3e8c4,#b0d7ff,#ffc4a6)]"
            aria-hidden="true"
          >
          </div>
          <Image
            src={profile}
            alt={hero.photo_alt}
            widths={[288, 448, 640]}
            sizes="(min-width: 768px) 21rem, 18rem"
            loading="eager"
            fetchpriority="high"
            class="relative size-full rounded-full border-[6px] border-bg object-cover"
          />
        </div>
        <p class="absolute -bottom-3 left-1/2 inline-flex -translate-x-1/2 items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-sm font-semibold whitespace-nowrap shadow-[var(--shadow)] md:left-auto md:right-0 md:translate-x-0">
          <span class="relative flex size-2.5" aria-hidden="true">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-[var(--mint-strong)] opacity-60 motion-reduce:hidden"></span>
            <span class="relative inline-flex size-2.5 rounded-full bg-[var(--mint-strong)]"></span>
          </span>
          {hero.availability.split(' · ')[0]}
        </p>
      </div>

      <!-- Text -->
      <div class="text-center md:text-left">
        <p class="font-display text-xl font-semibold text-muted sm:text-2xl">{hero.greeting}</p>
        <h1 class="mt-1 font-display text-5xl leading-[1] font-extrabold tracking-[-0.04em] sm:text-6xl lg:text-7xl">
          {hero.name.split(' ')[0]}{' '}
          <span class="relative whitespace-nowrap">
            <span class="absolute inset-x-[-0.1em] bottom-[0.06em] -z-10 h-[0.32em] rounded-full bg-[var(--lilac)]" aria-hidden="true"></span>
            {hero.name.split(' ').slice(1).join(' ')}
          </span>
        </h1>

        <p class="mt-5 min-h-[2lh] font-display text-xl font-medium sm:min-h-0 sm:text-2xl">
          <span class="sr-only">{hero.headline}</span>
          <span aria-hidden="true">
            {hero.roles_prefix}{' '}
            <span class="typed text-accent" data-roles={JSON.stringify(hero.roles)}>{hero.roles[0]}</span><span
              class="caret ml-0.5 inline-block h-[1.1em] w-[3px] translate-y-[0.18em] rounded-full bg-accent"
            ></span>
          </span>
        </p>

        <p class="mt-5 text-[1.0625rem] leading-relaxed text-muted [&_strong]:font-semibold [&_strong]:text-ink" set:html={md(hero.intro)} />

        <ul class="mt-8 grid grid-cols-3 gap-2 sm:gap-3" data-stagger>
          {
            hero.proof.map((p) => (
              <li
                class:list={[
                  'reveal stat relative overflow-hidden rounded-2xl border border-white/60 bg-white/55 px-3 pt-4 pb-3 text-left sm:px-4 sm:pt-5 sm:pb-4 shadow-[var(--shadow)] backdrop-blur-md dark:border-white/10 dark:bg-white/5',
                  'c-' + p.color,
                ]}
              >
                <span class="absolute inset-x-0 top-0 h-1 bg-c-strong" aria-hidden="true" />
                <p class="font-mono text-lg font-semibold tracking-tight text-c-strong sm:text-2xl">
                  <span data-count={p.count}>{p.count.toLocaleString('en-US')}</span>
                  {p.suffix}
                </p>
                <p class="mt-1 text-xs leading-snug text-muted sm:text-sm">{p.label}</p>
              </li>
            ))
          }
        </ul>

        <p class="mt-6 text-sm font-medium text-muted">{hero.availability}</p>

        <div class="mt-4 flex flex-wrap justify-center gap-2.5 md:justify-start">
          {
            hero.buttons.map((b, i) =>
              b.href.startsWith('mailto:') ? (
                <button
                  type="button"
                  class="btn copy-email-hero"
                  data-email={b.href.slice('mailto:'.length)}
                  data-copied={contact.copied_label}
                  aria-label={`${contact.copy_label}: ${b.href.slice('mailto:'.length)}`}
                >
                  <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
                  </svg>
                  <span class="label-text">{b.href.slice('mailto:'.length)}</span>
                  <svg class="size-4 shrink-0 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" />
                  </svg>
                </button>
              ) : (
                <a href={b.href} class:list={['btn', i === 0 && 'btn-primary']}>
                  {b.label}
                </a>
              ),
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Selected work -->
  <section id="work" class="container-page scroll-mt-20" aria-labelledby="work-h">
    <p class="eyebrow">01</p>
    <h2 id="work-h" class="section-title mt-3">{work.heading}</h2>
    <p class="mt-3 text-lg text-muted">{work.intro}</p>
    <div class="mt-10 grid gap-8">
      {
        work.cards.map((c, i) => (
          <article class:list={['reveal tilt card group relative grid overflow-hidden md:grid-cols-2', 'c-' + c.color]}>
            <div class:list={['relative flex items-center justify-center overflow-hidden bg-c-soft p-5 sm:p-8', i % 2 && 'md:order-2']}>
              {c.visual.kind === 'collage' && c.visual.images ? (
                <Collage images={c.visual.images} layout={c.visual.layout} />
              ) : c.visual.kind === 'image' && c.visual.src ? (
                <Image
                  src={image(c.visual.src)}
                  alt={c.visual.alt}
                  widths={[480, 800, 1100]}
                  sizes="(min-width: 768px) 34rem, 100vw"
                  loading="lazy"
                  class="w-full rounded-xl border border-line shadow-lg transition-transform duration-500 group-hover:scale-[1.03] group-hover:-rotate-1"
                />
              ) : (
                <div class="diagram w-full rounded-xl bg-surface p-3 shadow-lg transition-transform duration-500 group-hover:scale-[1.03] sm:p-5">
                  <Thumb id={c.visual.id as 'beekeeper-pipeline-thumb' | 'pfa-architecture-thumb'} alt={c.visual.alt} />
                </div>
              )}
            </div>
            <div class="flex flex-col p-6 sm:p-8">
              <p class="eyebrow">{c.kicker}</p>
              <h3 class="mt-3 flex items-center gap-3 font-display text-3xl font-bold tracking-tight">
                {c.logo && <Logo src={c.logo} px={40} class="size-10 shrink-0 object-contain" />}
                <a href={`/work/${c.slug}`} class="after:absolute after:inset-0">
                  {c.title}
                </a>
              </h3>
              {c.links ? (
                  <ul class="relative z-10 mt-4 flex flex-wrap gap-2">
                    {c.links.map((l, j) => (
                      <li>
                        <a
                          href={l.href}
                          class:list={[
                            'inline-flex min-h-10 items-center gap-1.5 rounded-full px-4 text-sm font-semibold transition-transform hover:-translate-y-0.5',
                            j === 0 ? 'bg-c-strong text-surface' : 'border-[1.5px] border-c-strong text-c-strong hover:bg-c-soft',
                          ]}
                        >
                          {l.label}
                          <svg class="size-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M5 11 11 5M6 5h5v5" />
                          </svg>
                        </a>
                      </li>
                    ))}
                  </ul>
              ) : (
              <ul class="mt-4 flex flex-wrap gap-2" aria-label="Highlights">
                {c.badges.map((b) => (
                  <li class="badge">{b}</li>
                ))}
              </ul>
              )}
              <p class="mt-4 text-[1.0625rem] leading-relaxed">{c.summary}</p>
              <ul class="mt-4 space-y-2 text-[0.9375rem] leading-snug text-muted [&_code]:rounded [&_code]:bg-c-soft [&_code]:px-1.5 [&_code]:font-mono [&_code]:text-ink [&_strong]:text-ink">
                {c.proof.map((p) => (
                  <li class="flex gap-2.5">
                    <span class="mt-[0.45em] block size-2 shrink-0 rounded-full bg-c" aria-hidden="true" />
                    <span set:html={md(p)} />
                  </li>
                ))}
              </ul>
              <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Stack">
                {c.stack.map((s) => (
                  <li class="tag">{s}</li>
                ))}
              </ul>
              <p class="mt-6 inline-flex items-center gap-1.5 pt-1 font-semibold text-c-strong md:mt-auto">
                {c.cta}
                <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1.5">→</span>
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- What I'm looking for -->
  <section id="looking" class="container-page mt-28 scroll-mt-20" aria-labelledby="looking-h">
    <div class="reveal relative overflow-hidden rounded-[2rem] bg-[linear-gradient(120deg,var(--lilac-soft),var(--peach-soft)_55%,var(--mint-soft))] p-7 sm:p-12">
      <div class="blob pointer-events-none absolute -right-16 -bottom-20 size-64 rounded-full bg-[var(--lilac)] opacity-50 blur-3xl" aria-hidden="true"></div>
      <p class="eyebrow">02 · {looking.heading}</p>
      <h2 id="looking-h" class="section-title relative mt-3 max-w-3xl">{looking.title}</h2>
      <p class="relative mt-5 max-w-2xl text-lg leading-relaxed">{looking.text}</p>
      <ul class="relative mt-7 flex flex-wrap gap-2.5" data-stagger>
        {
          looking.chips.map((ch) => (
            <li class:list={['reveal badge !px-4 !py-2 !text-[0.9375rem] shadow-sm', 'c-' + ch.color, '!bg-surface']}>{ch.label}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Experience + Education -->
  <section id="experience" class="container-page mt-28 scroll-mt-20" aria-labelledby="exp-h">
    <p class="eyebrow">03</p>
    <h2 id="exp-h" class="section-title mt-3">{experience.heading}</h2>
    <ol class="relative mt-10 space-y-6 before:absolute before:top-2 before:bottom-2 before:left-[0.6875rem] before:w-0.5 before:rounded-full before:bg-[linear-gradient(var(--peach),var(--lilac),var(--mint))] sm:before:left-[0.6875rem]" data-stagger>
      {
        experience.items.map((e) => (
          <li class:list={['reveal relative pl-10', 'c-' + e.color]}>
            <span class="absolute top-6 left-0 grid size-6 place-items-center rounded-full bg-c-soft ring-4 ring-bg" aria-hidden="true">
              <span class="size-2.5 rounded-full bg-c-strong" />
            </span>
            <div class="tilt card p-5 sm:p-6">
              <p class="eyebrow">{e.dates}</p>
              <h3 class="mt-2 flex items-start gap-3 text-xl font-bold tracking-tight">
                {e.logo && <Logo src={e.logo} px={40} class="size-10 shrink-0 rounded-lg object-contain" />}
                <span>
                  {e.role} <span class="font-sans text-base font-normal text-muted">· {e.org}</span>
                </span>
              </h3>
              <p class="mt-2 max-w-3xl leading-relaxed text-muted [&_strong]:font-semibold [&_strong]:text-ink" set:html={md(e.text)} />
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {e.tags.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <h2 id="edu-h" class="section-title mt-20 !text-3xl">{education.heading}</h2>
    <div class="reveal tilt card c-sky mt-6 flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:p-8">
      <div class="grid size-14 shrink-0 place-items-center rounded-2xl bg-c-soft text-c-strong" aria-hidden="true">
        <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 9.5 12 5l10 4.5-10 4.5L2 9.5Z"></path><path d="M6 11.5V16c0 1.4 2.7 3 6 3s6-1.6 6-3v-4.5"></path><path d="M22 9.5V15"></path>
        </svg>
      </div>
      <div>
        <p class="eyebrow">{education.dates}</p>
        <h3 class="mt-1.5 text-xl font-bold tracking-tight">
          {education.degree} <span class="font-sans text-base font-normal text-muted">· {education.school}</span>
        </h3>
        <p class="mt-1 text-muted [&_strong]:font-semibold [&_strong]:text-ink" set:html={md(education.details)} />
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills" class="container-page mt-28 scroll-mt-20" aria-labelledby="skills-h">
    <p class="eyebrow">04</p>
    <h2 id="skills-h" class="section-title mt-3">{skills.heading}</h2>
    <p class="mt-3 text-lg text-muted">{skills.intro}</p>
    <div class="mt-10">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
        {
          skills.groups.map((g) => (
            <div class:list={['reveal tilt glass relative isolate overflow-hidden rounded-3xl p-5 sm:p-6', 'c-' + g.color]}>
              <div class="flex items-center gap-3">
                <span class="glass-chip grid size-9 place-items-center rounded-xl" aria-hidden="true">
                  <span class="size-3 rounded-full bg-c-strong" />
                </span>
                <h3 class="text-lg font-bold">{g.name}</h3>
              </div>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {g.items.map((s) => (
                  <li class="glass-tag">{s}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Writing -->
  {
    latestPosts.length > 0 && (
      <section id="writing" class="container-page mt-28 scroll-mt-20" aria-labelledby="writing-h">
        <p class="eyebrow">05</p>
        <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
          <h2 id="writing-h" class="section-title">{ui.blog_heading}</h2>
          <a href="/blog" class="btn">{ui.blog_back} →</a>
        </div>
        <p class="mt-3 text-lg text-muted">{ui.blog_intro}</p>
        <div class="mt-10 grid gap-6 lg:grid-cols-2" data-stagger>
          {latestPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    )
  }

  <!-- Contact -->
  <section id="contact" class="container-page mt-28 scroll-mt-20" aria-labelledby="contact-h">
    <div class="reveal relative isolate overflow-hidden rounded-[2rem] bg-[#1e1b2e] px-6 py-14 text-center text-white sm:px-12 sm:py-20">
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div class="blob absolute -top-20 -left-10 size-72 rounded-full bg-[#ffc4a6] opacity-40 blur-3xl"></div>
        <div class="blob absolute -right-10 -bottom-24 size-80 rounded-full bg-[#cdb9ff] opacity-40 blur-3xl"></div>
        <div class="blob absolute top-10 left-1/2 size-56 rounded-full bg-[#a3e8c4] opacity-25 blur-3xl"></div>
      </div>
      <p class="font-mono text-sm font-semibold text-[#cdb9ff]">06 · {contact.heading}</p>
      <h2 id="contact-h" class="mx-auto mt-4 max-w-3xl font-display text-3xl leading-[1.1] font-extrabold tracking-[-0.03em] sm:text-5xl">
        {contact.title}
      </h2>
      <p class="mt-4 text-xl text-white/80">{contact.text}</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href={`mailto:${contact.email}`}
          class="inline-flex min-h-12 items-center rounded-full bg-[#ffc4a6] px-6 font-semibold text-[#1e1b2e] transition-transform hover:-translate-y-0.5 hover:bg-white sm:text-lg"
        >
          {contact.email}
        </a>
        <button
          type="button"
          class="copy-email inline-flex min-h-12 items-center rounded-full border border-white/30 px-5 font-semibold text-white transition-colors hover:border-white hover:bg-white/10"
          data-email={contact.email}
          data-copied={contact.copied_label}
          data-label={contact.copy_label}
        >
          {contact.copy_label}
        </button>
      </div>
      <p class="sr-only" aria-live="polite" data-copy-status></p>
      <ul class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2 text-white/85">
        {
          contact.links.map((l) => (
            <li>
              <a href={l.href} class="inline-flex min-h-11 items-center underline decoration-white/30 underline-offset-4 hover:text-white hover:decoration-white">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<script>
  // Typed rotating role line.
  const el = document.querySelector<HTMLElement>('.typed');
  const roles: string[] = el ? JSON.parse(el.dataset.roles ?? '[]') : [];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && roles.length > 1 && !reduce) {
    let r = 0;
    const sleep = (ms: number) => new Promise((res) => setTimeout(res, ms));
    (async () => {
      await sleep(2600);
      for (;;) {
        const current = roles[r];
        for (let i = current.length; i >= 0; i--) {
          el.textContent = current.slice(0, i);
          await sleep(28);
        }
        r = (r + 1) % roles.length;
        const next = roles[r];
        for (let i = 1; i <= next.length; i++) {
          el.textContent = next.slice(0, i);
          await sleep(55);
        }
        await sleep(2400);
      }
    })();
  }

  // Hero email button: shows the address, copies it on click.
  document.querySelectorAll<HTMLButtonElement>('.copy-email-hero').forEach((btn) => {
    const text = btn.querySelector<HTMLElement>('.label-text');
    const email = btn.dataset.email ?? '';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
        if (text) text.textContent = btn.dataset.copied ?? 'Copied!';
        const status = document.querySelector('[data-copy-status]');
        if (status) status.textContent = btn.dataset.copied ?? '';
        setTimeout(() => text && (text.textContent = email), 1800);
      } catch {
        // Clipboard blocked: the address is still shown on the button.
      }
    });
  });

  // Copy the email address.
  document.querySelectorAll<HTMLButtonElement>('.copy-email').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.email ?? '');
        btn.textContent = btn.dataset.copied ?? 'Copied';
        const status = document.querySelector('[data-copy-status]');
        if (status) status.textContent = btn.dataset.copied ?? '';
        setTimeout(() => (btn.textContent = btn.dataset.label ?? 'Copy'), 1800);
      } catch {
        // Clipboard blocked: the address is still on the button next to it.
      }
    });
  });
</script>
