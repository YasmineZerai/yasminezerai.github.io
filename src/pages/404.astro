---
import Base from '../layouts/Base.astro';
import { getUi } from '../lib/content';
const ui = await getUi();
---

<Base title={`${ui.not_found_title} · Yasmine Zerai`} description={ui.not_found_text}>
  <section class="container-text py-24">
    <p class="label">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">{ui.not_found_title}</h1>
    <p class="mt-4 text-lg text-muted">{ui.not_found_text}</p>
    <p class="mt-8"><a href="/" class="btn btn-primary">{ui.not_found_link}</a></p>
  </section>
</Base>
