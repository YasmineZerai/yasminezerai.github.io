---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getUi } from '../../lib/content';
import { getPosts } from '../../lib/blog';

const ui = await getUi();
const posts = await getPosts();
---

<Base title={`${ui.blog_heading} · Yasmine Zerai`} description={ui.blog_intro}>
  <section class="container-text pt-12 pb-4 sm:pt-20">
    <p class="eyebrow">{ui.blog_heading}</p>
    <h1 class="section-title mt-3">{ui.blog_heading}</h1>
    <p class="mt-3 text-lg text-muted">{ui.blog_intro}</p>
  </section>
  <section class="container-text mt-8 grid gap-6" data-stagger>
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</Base>
